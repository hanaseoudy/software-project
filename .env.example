# MongoDB Atlas connection
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@travelcluster.i7swkkp.mongodb.net/travel_booking

# ACC-18 admin seeding (npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
# ACC-19 authentication tokens (use long random values; never commit real ones)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1800

# ACC-06 idle session timeout (30 minutes)
SESSION_IDLE_TIMEOUT_SECONDS=1800

# GEN-01-B email notifications over SMTP
# Development: leave SMTP_HOST empty to use a free Ethereal test inbox (links are printed in the server log),
# or paste the SMTP settings of a Mailtrap test inbox here. Production: set your real SMTP server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Travel Planner <no-reply@travel-planner.test>"
# Website address used for links in emails
FRONTEND_URL=http://localhost:3001

# PAY-01 Stripe test mode (use test keys only; never commit real ones)
STRIPE_SECRET_KEY=sk_test_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me
