{
  "info": {
    "_postman_id": "9710804f-4243-5bd6-af4e-66c33abb1ea7",
    "name": "GEN-10 Admin moderation",
    "description": "GEN-10: admins list reports, resolve them (dismiss / hide / delete) and hide, unhide or delete posts and comments directly. Run 'Auth > Login as admin' (saves {{token}}) and 'Login as normal user' (saves {{userToken}}, for 403 cases) first. Fill the id variables with data from your database (the GEN-09 collection creates reports).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as admin (saves {{token}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Use an admin account (see ACC-18 admin seeding).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the access_token cookie set by the login response into {{token}}",
                  "let t = pm.cookies.get('access_token');",
                  "if (!t) {",
                  "  // fallback: the cookie is Secure, so read it straight from Set-Cookie on http://localhost",
                  "  pm.response.headers.each((h) => {",
                  "    const m = h.key.toLowerCase() === 'set-cookie' && /access_token=([^;]+)/.exec(h.value);",
                  "    if (m) { t = m[1]; }",
                  "  });",
                  "}",
                  "if (t) { pm.collectionVariables.set('token', t); }",
                  "pm.test('Logged in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as normal user (saves {{userToken}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Any non-admin account; used for the 403 requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the access_token cookie set by the login response into {{token}}",
                  "let t = pm.cookies.get('access_token');",
                  "if (!t) {",
                  "  // fallback: the cookie is Secure, so read it straight from Set-Cookie on http://localhost",
                  "  pm.response.headers.each((h) => {",
                  "    const m = h.key.toLowerCase() === 'set-cookie' && /access_token=([^;]+)/.exec(h.value);",
                  "    if (m) { t = m[1]; }",
                  "  });",
                  "}",
                  "if (t) { pm.collectionVariables.set('userToken', t); }",
                  "pm.test('Logged in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
