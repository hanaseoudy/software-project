{
  "info": {
    "_postman_id": "050bf8fe-93ab-5f9b-9f72-d31a3f8aeb03",
    "name": "GEN-09 Reports",
    "description": "GEN-09: report a post, comment, review or itinerary with a reason, at most once per item. Run 'Auth > Login' first; it stores the access_token cookie in {{token}}. Set postId, commentId and reviewId to existing items before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (saves {{token}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in and stores the access_token cookie in the {{token}} collection variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the access_token cookie set by the login response into {{token}}",
                  "let t = pm.cookies.get('access_token');",
                  "if (!t) {",
                  "  // fallback: the cookie is Secure, so read it straight from Set-Cookie on http://localhost",
                  "  pm.response.headers.each((h) => {",
                  "    const m = h.key.toLowerCase() === 'set-cookie' && /access_token=([^;]+)/.exec(h.value);",
                  "    if (m) { t = m[1]; }",
                  "  });",
                  "}",
                  "if (t) { pm.collectionVariables.set('token', t); }",
                  "pm.test('Logged in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Report an item",
      "item": [
        {
          "name": "Report a post - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "access_token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            },
            "description": "Set {{postId}} to an existing post. Saves {{reportId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetType\": \"post\",\n  \"targetId\": \"{{postId}}\",\n  \"reason\": \"This contains offensive language.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) { pm.collectionVariables.set('reportId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
