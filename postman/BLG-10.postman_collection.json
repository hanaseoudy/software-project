                "images"
              ]
            },
            "description": "Pick a JPG or PNG under 5 MB. Saves the new image id in {{imageId}}.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "src": [],
                  "description": "Choose a file"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const imgs = pm.response.json().images; pm.collectionVariables.set('imageId', imgs[imgs.length - 1].id); }",
                  "pm.test('Images returned with id and url', () => pm.response.json().images.forEach((i) => pm.expect(i).to.have.keys('id', 'url')));"
                ]
              }
            }
