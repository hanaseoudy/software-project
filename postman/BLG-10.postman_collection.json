{
  "info": {
    "_postman_id": "f71ca574-9326-5dab-b4ab-d11652538dfd",
    "name": "BLG-10 Post images",
    "description": "BLG-10: attach images to / remove images from my own post under the GEN-08 rules (JPG/PNG, max 5 MB, max 5 images per post). Run 'Auth > Login' first; it stores the access_token cookie in {{token}}. For each upload request, choose the file(s) in the Body > form-data 'images' rows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (saves {{token}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in and stores the access_token cookie in the {{token}} collection variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the access_token cookie set by the login response into {{token}}",
                  "let t = pm.cookies.get('access_token');",
                  "if (!t) {",
                  "  // fallback: the cookie is Secure, so read it straight from Set-Cookie on http://localhost",
                  "  pm.response.headers.each((h) => {",
                  "    const m = h.key.toLowerCase() === 'set-cookie' && /access_token=([^;]+)/.exec(h.value);",
                  "    if (m) { t = m[1]; }",
                  "  });",
                  "}",
                  "if (t) { pm.collectionVariables.set('token', t); }",
                  "pm.test('Logged in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Setup",
      "item": [
        {
          "name": "Create a post to attach images to - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "access_token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Three days in Luxor\",\n  \"content\": \"We started at Karnak Temple...\",\n  \"tags\": [\n    \"egypt\"\n  ],\n  \"status\": \"published\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) { pm.collectionVariables.set('postId', pm.response.json().id); }"
                ]
              }
            }
          ]
        }
      ]
    },
