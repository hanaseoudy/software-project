      "name": "Posts - tags",
      "item": [
        {
          "name": "Create post with tags - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "access_token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "Tags are trimmed, lowercased and de-duplicated -> ['rome', 'food']. Saves {{postId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My trip to Rome\",\n  \"content\": \"We started the day at the Colosseum...\",\n  \"tags\": [\n    \"Rome\",\n    \"food\",\n    \"rome\"\n  ],\n  \"status\": \"published\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) { pm.collectionVariables.set('postId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
