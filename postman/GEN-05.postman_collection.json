{
  "info": {
    "_postman_id": "634b21b6-879b-5176-a46c-462420cb9824",
    "name": "GEN-05 Pagination (page size 10)",
    "description": "GEN-05: every list (posts, my posts, tags, posts by tag and post comments) uses a fixed page size of 10, selected with ?page=N. Run 'Auth > Login' first; it stores the access_token cookie in {{token}}. 400 cases rely on the global ValidationPipe and the /api prefix from develop's main.ts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (saves {{token}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in and stores the access_token cookie in the {{token}} collection variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the access_token cookie set by the login response into {{token}}",
                  "let t = pm.cookies.get('access_token');",
                  "if (!t) {",
                  "  // fallback: the cookie is Secure, so read it straight from Set-Cookie on http://localhost",
                  "  pm.response.headers.each((h) => {",
                  "    const m = h.key.toLowerCase() === 'set-cookie' && /access_token=([^;]+)/.exec(h.value);",
                  "    if (m) { t = m[1]; }",
                  "  });",
                  "}",
                  "if (t) { pm.collectionVariables.set('token', t); }",
                  "pm.test('Logged in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
