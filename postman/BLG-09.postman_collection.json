{
  "info": {
    "_postman_id": "8219b01f-8818-5c04-b4e4-3df34012155a",
    "name": "BLG-09 Post search",
    "description": "BLG-09: public search of published posts by title, tags or author name, ranked by interaction score (likes + comments) then newest first, 10 per page. No login needed. Set titleKeyword, tagKeyword and authorKeyword to values that exist in your database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Search - success",
      "item": [
        {
          "name": "Search by title - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/search?q={{titleKeyword}}&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{titleKeyword}}"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Matches the keyword anywhere in the title (case-insensitive)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Paginated shape, page size 10', () => {",
                  "  pm.expect(b).to.include.keys('items', 'total', 'page', 'pageSize', 'totalPages');",
                  "  pm.expect(b.pageSize).to.eql(10);",
                  "  pm.expect(b.items.length).to.be.at.most(10);",
                  "});",
                  "pm.test('Items have only the search fields', () => {",
                  "  b.items.forEach((i) => pm.expect(Object.keys(i).sort()).to.eql(",
                  "    ['author', 'commentsCount', 'createdAt', 'excerpt', 'id', 'interactionScore', 'likesCount', 'tags', 'title']));",
                  "});",
                  "pm.test('Sorted by interaction score desc, then newest first', () => {",
                  "  for (let k = 1; k < b.items.length; k++) {",
                  "    const a = b.items[k - 1], c = b.items[k];",
                  "    pm.expect(a.interactionScore >= c.interactionScore).to.be.true;",
                  "    if (a.interactionScore === c.interactionScore) {",
                  "      pm.expect(new Date(a.createdAt) >= new Date(c.createdAt)).to.be.true;",
                  "    }",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
