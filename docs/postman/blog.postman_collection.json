{
  "info": {
    "_postman_id": "ceb88c54-382c-5e48-b87d-13fb603149a6",
    "name": "Blog API (BLG-01 to BLG-08)",
    "description": "Blog and community endpoints with success and error cases. Run 'Auth > Login' first: it stores the access_token cookie in {{token}}, which protected requests send as 'Cookie: access_token={{token}}'. 'Create post' and 'Add comment' fill {{postId}} and {{commentId}} automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (saves {{token}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the access_token cookie set by the login response into {{token}}",
                  "let t = pm.cookies.get('access_token');",
                  "if (!t) {",
                  "  // fallback: the cookie is Secure, so read it straight from Set-Cookie on http://localhost",
                  "  pm.response.headers.each((h) => {",
                  "    const m = h.key.toLowerCase() === 'set-cookie' && /access_token=([^;]+)/.exec(h.value);",
                  "    if (m) { t = m[1]; }",
                  "  });",
                  "}",
                  "if (t) { pm.collectionVariables.set('token', t); }",
                  "pm.test('Logged in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
