# Copy to .env.local and adjust. Never put secrets in NEXT_PUBLIC_* variables.

# Address of the NestJS backend. Server-only: used by the /api proxy
# (next.config.ts) and serverFetch. Required for every build (Vercel, CI).
BACKEND_URL=http://localhost:3000

# PAYC-1: Stripe *publishable* key for the card form (Stripe Elements). It is public by
# design, so NEXT_PUBLIC_ is fine here; never put the secret key (sk_...) in the frontend.
# Test mode only: put your own pk_test_... key in .env.local (Stripe Dashboard, Developers > API keys).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
